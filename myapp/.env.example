# このファイルをコピーして .env を作り、実際の値を入れてください。
# cp .env.example .env

# Djangoのセッション署名などに使う秘密鍵。以下のコマンドで生成できます。
# python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=

# ローカル開発では True、本番(Render)では False のままにしてください
DEBUG=True

# DB接続文字列。ローカルではSQLiteで十分です。
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary（画像アップロード先）の認証情報。cloudinary.com のダッシュボードで確認できます。
CLOUD_NAME=
API_KEY=
API_SECRET=
